# ---------------------------------------------------------------------------
# Lumen Research Workspace — configuration
#
# Everything here is OPTIONAL. With no keys at all the workspace still does
# real research: it searches free academic databases, fetches and parses
# sources, ranks them, indexes them, runs statistics, draws charts and formats
# citations. What it will NOT do without a reasoning model is write prose —
# it answers by quoting the passages it retrieved, and says so.
# ---------------------------------------------------------------------------

# --- storage ---------------------------------------------------------------
DATA_DIR=./var
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/lumen   # default: SQLite

# --- reasoning model (enables synthesis, images, diagrams, paper analysis) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# Any OpenAI-compatible endpoint also works (Azure, vLLM, Ollama, OpenRouter…)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# LLM_PROVIDER=auto        # auto | anthropic | openai | extractive

# --- open-web search (any one of these enables it) --------------------------
# TAVILY_API_KEY=tvly-...          # returns page content with each hit
# BRAVE_API_KEY=...
# SERPER_API_KEY=...
# SEARXNG_BASE_URL=http://localhost:8080   # self-hosted, no key needed

# WEB_SEARCH_PROVIDERS=auto        # auto | tavily,brave | none

# --- academic databases (all free, no key required) -------------------------
ACADEMIC_PROVIDERS=openalex,europepmc,crossref,arxiv
# SEMANTICSCHOLAR_API_KEY=...      # optional: raises the rate limit

# Sent to polite-pool APIs (OpenAlex, Crossref) so they can contact you.
CONTACT_EMAIL=you@example.org

# --- research policy --------------------------------------------------------
RESPECT_ROBOTS_TXT=true
HTTP_TIMEOUT_SECONDS=25
MAX_FETCH_BYTES=8000000
MAX_UPLOAD_BYTES=64000000
DEFAULT_MAX_SOURCES=12

# --- server -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
